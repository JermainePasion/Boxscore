# Production image for the BoxScore API: Node (Express + Prisma) plus Python (nba_api scripts).
FROM node:20-bookworm-slim

# Python for the nba_api scripts, OpenSSL for Prisma
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Python packages in their own environment. This also provides the `python`
# command that runNbaScript calls. tzdata gives zoneinfo the US Eastern timezone.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir nba_api tzdata

WORKDIR /app

# Dependencies first, so code changes don't reinstall them on every build.
# (prisma/ is copied too in case package.json runs `prisma generate` on install.)
COPY package*.json ./
COPY prisma ./prisma
RUN npm ci && npx prisma generate

COPY . .

ENV NODE_ENV=production
EXPOSE 5000

# Apply any new database migrations, then start the server.
CMD ["sh", "-c", "npx prisma migrate deploy && npm start"]
