# Droplet .env: copy to ~/boxscore/.env (next to docker-compose.prod.yml) and fill in.
# Never commit the real one.

# Makes plain `docker compose ...` use the production file
COMPOSE_FILE=docker-compose.prod.yml

# Address the API is served at. Until you buy a domain, sslip.io gives the
# droplet's IP a name that can get an HTTPS certificate:
API_DOMAIN=157-245-54-136.sslip.io
# later: API_DOMAIN=api.yourdomain.com

# Supabase > Connect > Session pooler (port 5432), with your password filled in
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOURPASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Same variable name your local server/.env uses for the JWT secret.
# Use a NEW random value here:  openssl rand -hex 32
JWT_SECRET=replace-me

YOUTUBE_API_KEY=replace-me

# NBA stats through the laptop relay
NBA_PROXY=http://100.104.137.16:8899

# Headshots: DataImpulse, or the laptop relay (same value as NBA_PROXY) to skip DataImpulse
IMG_PROXY=http://LOGIN:PASSWORD@gw.dataimpulse.com:823

# Daily game sync (2:30 PM and 9:00 PM Manila)
GAME_SYNC=on

# Set in step 3 (Cloudflare Pages)
FRONTEND_URL=
